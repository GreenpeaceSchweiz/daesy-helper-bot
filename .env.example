# FOR LOCAL DEVELOPMENT

# Google AI Studio / Gemini Setup
#GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT="project-name"
GOOGLE_CLOUD_LOCATION="eu"
GOOGLE_CLOUD_AGENT_ENGINE_ID="id_returned_by_script" #see scripts/create_agent_engine.py

# Asana Setup
ASANA_PERSONAL_ACCESS_TOKEN=your_asana_token_here
ASANA_PROJECT_INTAKE=your_target_project_id_here # this is the project where new tasks will be written to
ASANA_PROJECT_LOOKUP=your_target_project_id_here # this is the project that will be searched to find existing tasks
ASANA_WORKSPACE=your_workspace_id_here
ASANA_FIELD_CREATOR=custom_field_gid_here

# Slack Setup
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Peerdom Setup (Optional: for organizational context/role lookup)
PEERDOM_API_KEY=your_peerdom_api_key_here